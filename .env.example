# Copy to .env and fill in.
PORT=3000
# Public address of the site (used in the invoice links sent on WhatsApp/e-mail)
BASE_URL=https://radios.example.co.za
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Code needed to create the first admin account (protects the site before you've set it up)
SETUP_CODE=
# Where the database and uploaded signed agreements are stored (back this folder up!)
DATA_DIR=./data

# --- E-mail (SMTP). Gmail: smtp.gmail.com / 587 / your address / an App Password ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SCPF Radios <admin@scpf.co.za>"

# --- Optional: WhatsApp Business Cloud API (automatic sending). Leave blank to use click-to-send links. ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
DEFAULT_COUNTRY_CODE=27

# --- Seller / bank details printed on invoices (defaults match the agreement) ---
# SELLER_NAME="Sinoville Community Police Forum"
# SELLER_SHORT_NAME=SCPF
# SELLER_EMAIL=admin@scpf.co.za
# BANK_NAME="First National Bank"
# BANK_ACCOUNT_NAME="Sinoville Community Police Forum"
# BANK_ACCOUNT_NUMBER="632 032 095 56"
# BANK_BRANCH_CODE=251037
# DEFAULT_RADIO_MODEL="Kirisun PT570"
# DEFAULT_PRICE=1400
